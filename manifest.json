{
  "manifest_version": 3,
  "name": "Letterboxd Random Picker",
  "version": "1.0.0",
  "description": "Randomly pick a movie from any Letterboxd list or watchlist you're viewing.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*/list/*",
        "https://letterboxd.com/*/watchlist*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
